{
  "manifest_version": 3,
  "name": "OpenFront Donor Calc Pro",
  "version": "4.0.1",
  "description": "Troop donation calculator overlay for OpenFront.io with a customizable, multilingual HUD. | github.com/announcerUA/openfront-donor-calculator",
  "permissions": ["storage"],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenFront Donor Calc Pro",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://openfront.io/*",
        "*://*.openfront.io/*",
        "*://nightly.openfront.dev/*"
      ],
      "js": ["i18n.js", "settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
